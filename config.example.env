# Copie este archivo como .env y complete sus propios valores.
# El archivo .env está excluido de Git.

SYSTEM=WMS
NAMESPACE=mi-namespace

PROJECT_DEV=mi-proyecto-dev
PROJECT_QA=mi-proyecto-qa
PROJECT_STAG=mi-proyecto-stag

